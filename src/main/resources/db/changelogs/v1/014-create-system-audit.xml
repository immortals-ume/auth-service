<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Dedicated sequence for SystemAuditUser (allocationSize=1 in entity) -->
    <changeSet id="v1-014-system-audit-seq" author="immortals-ume">
        <createSequence sequenceName="system_audit_seq"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>
        <rollback>
            <dropSequence sequenceName="system_audit_seq"/>
        </rollback>
    </changeSet>

    <!-- SYSTEM_AUDIT table — no schema annotation on entity, uses public schema -->
    <changeSet id="v1-014-system-audit-table" author="immortals-ume">
        <createTable tableName="SYSTEM_AUDIT">
            <column name="id"          type="BIGINT"       defaultValueSequenceNext="system_audit_seq"><constraints primaryKey="true" nullable="false"/></column>
            <column name="username"    type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="is_active"   type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <!-- Only one row should be active at a time -->
        <addUniqueConstraint constraintName="uk_system_audit_active"
                             tableName="SYSTEM_AUDIT"
                             columnNames="is_active"
                             deferrable="false"/>

        <rollback>
            <dropTable tableName="SYSTEM_AUDIT" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- Seed the system audit user used for created_by in all automated operations -->
    <changeSet id="v1-014-system-audit-seed" author="immortals-ume">
        <insert tableName="SYSTEM_AUDIT">
            <column name="id"          valueSequenceNext="system_audit_seq"/>
            <column name="username"    value="system"/>
            <column name="is_active"   valueBoolean="true"/>
            <column name="description" value="System account used for automated audit trail entries"/>
        </insert>

        <rollback>
            <delete tableName="SYSTEM_AUDIT">
                <where>username = 'system'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
