<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        system_audit_seq is created in 002-create-sequences.xml (public schema).
        SYSTEM_AUDIT lives in the public schema — used by AuditorAwareImpl to
        resolve the audit principal for system-initiated operations.
    -->

    <changeSet id="v1-014-system-audit-table" author="immortals-ume">
        <createTable tableName="SYSTEM_AUDIT">
            <column name="id"          type="BIGINT" defaultValueComputed="nextval('public.system_audit_seq')">
                <constraints primaryKey="true" primaryKeyName="pk_system_audit" nullable="false"/>
            </column>
            <column name="username"    type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="is_active"   type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <rollback>
            <dropTable tableName="SYSTEM_AUDIT" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- Seed the system audit user used for created_by in all automated operations -->
    <changeSet id="v1-014-system-audit-seed" author="immortals-ume">
        <insert tableName="SYSTEM_AUDIT">
            <column name="id"          valueComputed="nextval('public.system_audit_seq')"/>
            <column name="username"    value="system"/>
            <column name="is_active"   valueBoolean="true"/>
            <column name="description" value="System account used for automated audit trail entries"/>
        </insert>

        <rollback>
            <delete tableName="SYSTEM_AUDIT">
                <where>username = 'system'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
