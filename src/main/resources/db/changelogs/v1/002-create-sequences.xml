<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Per-table sequences in user_auth schema (allocationSize=50 matches @SequenceGenerator) -->
    <changeSet id="v1-002-seq-countries" author="immortals-ume">
        <createSequence sequenceName="countries_seq"
                        schemaName="user_auth"
                        startValue="1"
                        incrementBy="50"
                        minValue="1"
                        cycle="false"/>
        <rollback>
            <dropSequence sequenceName="countries_seq" schemaName="user_auth"/>
        </rollback>
    </changeSet>

