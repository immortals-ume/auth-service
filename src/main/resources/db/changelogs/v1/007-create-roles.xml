<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="v1-007-roles" author="immortals-ume">
        <createTable tableName="role" schemaName="user_auth">
            <!-- BaseEntity -->
            <column name="id" type="BIGINT" defaultValueComputed="nextval('user_auth.role_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <!-- role_id is a BIGINT business key set by @PrePersist -->
            <column name="role_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_role_role_id"/>
            </column>
            <column name="role_name" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_role_name"/>
            </column>
            <column name="description" type="VARCHAR(200)"/>
            <column name="active_ind" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <!-- Auditable -->
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_role_name" tableName="role" schemaName="user_auth">
            <column name="role_name"/>
        </createIndex>
        <createIndex indexName="idx_role_id_biz" tableName="role" schemaName="user_auth">
            <column name="role_id"/>
        </createIndex>
        <createIndex indexName="idx_role_active" tableName="role" schemaName="user_auth">
            <column name="active_ind"/>
        </createIndex>

        <rollback>
            <dropTable tableName="role" schemaName="user_auth" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>