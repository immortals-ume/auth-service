<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="v1-003-countries" author="immortals-ume">
        <createTable tableName="countries" schemaName="user_auth">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('user_auth.countries_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="country_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_countries_name"/>
            </column>
            <column name="country_code" type="VARCHAR(5)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_countries_code"/>
            </column>
            <column name="active_ind" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_countries_name" tableName="countries" schemaName="user_auth">
            <column name="country_name"/>
        </createIndex>
        <createIndex indexName="idx_countries_code" tableName="countries" schemaName="user_auth">
            <column name="country_code"/>
        </createIndex>

        <rollback>
            <dropTable tableName="countries" schemaName="user_auth" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>