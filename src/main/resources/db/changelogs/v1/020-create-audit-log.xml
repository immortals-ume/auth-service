<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd
                   http://www.liquibase.org/xml/ns/dbchangelog-ext
                   http://www.liquibase.org/xml/ns/dbchangelog-ext/dbchangelog-ext.xsd
                   http://www.liquibase.org/xml/ns/pro
                   http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.24.xsd">

    <!-- Create audit_log table for comprehensive audit tracking -->
    <changeSet id="001-create-audit-log-table" author="auth-service">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="public" tableName="audit_log"/>
            </not>
        </preConditions>

        <comment>Create audit_log table for comprehensive audit tracking with context information</comment>

        <createSequence sequenceName="audit_log_seq" schemaName="public" startValue="1" incrementBy="1"/>

        <createTable schemaName="public" tableName="audit_log" remarks="Comprehensive audit log for all system operations">
            <!-- Primary Key -->
            <column name="id" type="BIGINT" remarks="Unique audit record identifier">
                <constraints primaryKey="true" primaryKeyName="pk_audit_log"/>
            </column>

            <!-- Audit Metadata -->
            <column name="audit_date" type="TIMESTAMP" remarks="Date and time of the audit event">
                <constraints nullable="false"/>
            </column>
            <column name="audit_type" type="VARCHAR(50)" remarks="Type of audit (ENTITY_CHANGE, ACTION_AUDIT, SECURITY_AUDIT, etc.)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(100)" remarks="Specific action or operation being audited">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(20)" remarks="Severity level (INFO, WARNING, HIGH, CRITICAL)"/>

            <!-- User Context -->
            <column name="user_id" type="VARCHAR(100)" remarks="ID of the user performing the action"/>
            <column name="username" type="VARCHAR(255)" remarks="Username of the user performing the action">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(255)" remarks="Session identifier for request correlation"/>

            <!-- Request Context -->
            <column name="ip_address" type="VARCHAR(45)" remarks="Client IP address (supports IPv6)"/>
            <column name="user_agent" type="TEXT" remarks="Client user agent string"/>
            <column name="request_id" type="VARCHAR(255)" remarks="Unique request identifier for correlation">
                <constraints nullable="false"/>
            </column>

            <!-- Resource Information -->
            <column name="resource_type" type="VARCHAR(100)" remarks="Type of resource being audited (e.g., User, Payment, etc.)"/>
            <column name="resource_id" type="VARCHAR(255)" remarks="ID of the resource being audited"/>

            <!-- Change Information -->
            <column name="old_value" type="TEXT" remarks="Previous value before change (for UPDATE/DELETE operations)"/>
            <column name="new_value" type="TEXT" remarks="New value after change (for CREATE/UPDATE operations)"/>
            <column name="change_description" type="TEXT" remarks="Description of the change made"/>

            <!-- Additional Context -->
            <column name="additional_context" type="JSONB" remarks="Additional contextual information as JSON"/>

            <!-- Operation Result -->
            <column name="status" type="VARCHAR(20)" remarks="Status of the operation (SUCCESS, ERROR, SKIPPED)" defaultValue="SUCCESS">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT" remarks="Error message if operation failed"/>
            <column name="execution_time_ms" type="BIGINT" remarks="Execution time in milliseconds" defaultValue="0">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_date" type="TIMESTAMP" remarks="When this audit record was created" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropSequence sequenceName="audit_log_seq" schemaName="public"/>
            <dropTable schemaName="public" tableName="audit_log"/>
        </rollback>
    </changeSet>

    <!-- Create indexes for audit_log table -->
    <changeSet id="001-create-audit-log-indexes" author="auth-service">
        <comment>Create indexes on audit_log table for optimal query performance</comment>

        <!-- Index on created_date for time-range queries -->
        <createIndex indexName="idx_audit_log_created_date" tableName="audit_log" schemaName="public">
            <column name="created_date"/>
        </createIndex>

        <!-- Index on username for user-specific queries -->
        <createIndex indexName="idx_audit_log_username" tableName="audit_log" schemaName="public">
            <column name="username"/>
        </createIndex>

        <!-- Index on request_id for request correlation -->
        <createIndex indexName="idx_audit_log_request_id" tableName="audit_log" schemaName="public">
            <column name="request_id"/>
        </createIndex>

        <!-- Composite index on resource type and ID -->
        <createIndex indexName="idx_audit_log_resource" tableName="audit_log" schemaName="public">
            <column name="resource_type"/>
            <column name="resource_id"/>
        </createIndex>

        <!-- Index on audit_type -->
        <createIndex indexName="idx_audit_log_audit_type" tableName="audit_log" schemaName="public">
            <column name="audit_type"/>
        </createIndex>

        <!-- Index on severity -->
        <createIndex indexName="idx_audit_log_severity" tableName="audit_log" schemaName="public">
            <column name="severity"/>
        </createIndex>

        <!-- Index on status -->
        <createIndex indexName="idx_audit_log_status" tableName="audit_log" schemaName="public">
            <column name="status"/>
        </createIndex>

        <!-- Composite index on username and created_date for common query pattern -->
        <createIndex indexName="idx_audit_log_user_date" tableName="audit_log" schemaName="public">
            <column name="username"/>
            <column name="created_date" descending="true"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_audit_log_created_date" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_username" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_request_id" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_resource" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_audit_type" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_severity" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_status" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_user_date" tableName="audit_log" schemaName="public"/>
        </rollback>
    </changeSet>

    <!-- Add comments and constraints -->
    <changeSet id="001-add-audit-log-constraints" author="auth-service">
        <comment>Add constraints to ensure audit_log data integrity</comment>

        <!-- Check that audit_type is valid -->
        <addCheckConstraint
                catalogName="public"
                tableName="audit_log"
                columnDataType="VARCHAR(50)"
                constraintName="ck_audit_log_audit_type"
                schemaName="public"
                constraintBody="audit_type IN ('ENTITY_CHANGE', 'ACTION_AUDIT', 'SECURITY_AUDIT', 'DATA_AUDIT', 'SYSTEM_AUDIT', 'PERFORMANCE_AUDIT', 'COMPLIANCE_AUDIT', 'API_AUDIT')"/>

        <!-- Check that severity is valid -->
        <addCheckConstraint
                catalogName="public"
                tableName="audit_log"
                columnDataType="VARCHAR(20)"
                constraintName="ck_audit_log_severity"
                schemaName="public"
                constraintBody="severity IS NULL OR severity IN ('INFO', 'WARNING', 'HIGH', 'CRITICAL')"/>

        <!-- Check that status is valid -->
        <addCheckConstraint
                catalogName="public"
                tableName="audit_log"
                columnDataType="VARCHAR(20)"
                constraintName="ck_audit_log_status"
                schemaName="public"
                constraintBody="status IN ('SUCCESS', 'ERROR', 'SKIPPED')"/>

        <rollback>
            <dropConstraint
                    catalogName="public"
                    tableName="audit_log"
                    constraintName="ck_audit_log_audit_type"
                    schemaName="public"/>
            <dropConstraint
                    catalogName="public"
                    tableName="audit_log"
                    constraintName="ck_audit_log_severity"
                    schemaName="public"/>
            <dropConstraint
                    catalogName="public"
                    tableName="audit_log"
                    constraintName="ck_audit_log_status"
                    schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

