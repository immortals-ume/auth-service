<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        audit_log_seq is created in 002-create-sequences.xml (public schema).
        audit_log lives in public — append-only log for security and compliance events.
    -->

    <changeSet id="v1-016-audit-log-table" author="immortals-ume">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="public" tableName="audit_log"/></not>
        </preConditions>

        <createTable schemaName="public" tableName="audit_log">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('public.audit_log_seq')">
                <constraints primaryKey="true" primaryKeyName="pk_audit_log" nullable="false"/>
            </column>

            <!-- When and what -->
            <column name="audit_date"  type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="audit_type"  type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="action"      type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="severity"    type="VARCHAR(20)"/>

            <!-- Who -->
            <column name="user_id"    type="VARCHAR(100)"/>
            <column name="username"   type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="session_id" type="VARCHAR(255)"/>

            <!-- Request context -->
            <column name="ip_address"  type="VARCHAR(45)"/>
            <column name="user_agent"  type="TEXT"/>
            <column name="request_id"  type="VARCHAR(255)"><constraints nullable="false"/></column>

            <!-- Resource -->
            <column name="resource_type" type="VARCHAR(100)"/>
            <column name="resource_id"   type="VARCHAR(255)"/>

            <!-- Change payload -->
            <column name="old_value"          type="TEXT"/>
            <column name="new_value"          type="TEXT"/>
            <column name="change_description" type="TEXT"/>
            <column name="additional_context" type="JSONB"/>

            <!-- Result -->
            <column name="status"            type="VARCHAR(20)" defaultValue="SUCCESS"><constraints nullable="false"/></column>
            <column name="error_message"     type="TEXT"/>
            <column name="execution_time_ms" type="BIGINT"      defaultValueNumeric="0"><constraints nullable="false"/></column>

            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable schemaName="public" tableName="audit_log"/>
        </rollback>
    </changeSet>

    <changeSet id="v1-016-audit-log-indexes" author="immortals-ume">
        <createIndex indexName="idx_audit_log_created_date" tableName="audit_log" schemaName="public">
            <column name="created_date" descending="true"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_username" tableName="audit_log" schemaName="public">
            <column name="username"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_request_id" tableName="audit_log" schemaName="public">
            <column name="request_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_resource" tableName="audit_log" schemaName="public">
            <column name="resource_type"/>
            <column name="resource_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_audit_type" tableName="audit_log" schemaName="public">
            <column name="audit_type"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_severity" tableName="audit_log" schemaName="public">
            <column name="severity"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_status" tableName="audit_log" schemaName="public">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_audit_log_user_date" tableName="audit_log" schemaName="public">
            <column name="username"/>
            <column name="created_date" descending="true"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_audit_log_created_date" tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_username"     tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_request_id"   tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_resource"     tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_audit_type"   tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_severity"     tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_status"       tableName="audit_log" schemaName="public"/>
            <dropIndex indexName="idx_audit_log_user_date"    tableName="audit_log" schemaName="public"/>
        </rollback>
    </changeSet>

    <changeSet id="v1-016-audit-log-constraints" author="immortals-ume">
        <sql>
            ALTER TABLE public.audit_log
                ADD CONSTRAINT ck_audit_log_audit_type
                    CHECK (audit_type IN ('ENTITY_CHANGE','ACTION_AUDIT','SECURITY_AUDIT',
                                          'DATA_AUDIT','SYSTEM_AUDIT','PERFORMANCE_AUDIT',
                                          'COMPLIANCE_AUDIT','API_AUDIT'));

            ALTER TABLE public.audit_log
                ADD CONSTRAINT ck_audit_log_severity
                    CHECK (severity IS NULL OR severity IN ('INFO','WARNING','HIGH','CRITICAL'));

            ALTER TABLE public.audit_log
                ADD CONSTRAINT ck_audit_log_status
                    CHECK (status IN ('SUCCESS','ERROR','SKIPPED'));
        </sql>

        <rollback>
            <sql>
                ALTER TABLE public.audit_log DROP CONSTRAINT IF EXISTS ck_audit_log_audit_type;
                ALTER TABLE public.audit_log DROP CONSTRAINT IF EXISTS ck_audit_log_severity;
                ALTER TABLE public.audit_log DROP CONSTRAINT IF EXISTS ck_audit_log_status;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
