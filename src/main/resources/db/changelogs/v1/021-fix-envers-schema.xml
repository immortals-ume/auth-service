<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Idempotent repair changeset for Hibernate Envers audit tables.

        Handles two failure modes that can leave the DB in a broken state:
          1. The user_audit schema (or tables) were dropped after Liquibase marked
             the 012 changesets as "ran" — tables need to be recreated.
          2. The 012 changesets ran with the old column name "revtype" while Envers
             is configured with revision-type-field-name=rev_type — column needs rename.

        Each create-if-missing changeset uses preConditions onFail="MARK_RAN" so it
        is silently skipped when the table already exists.
        Each rename changeset uses preConditions onFail="MARK_RAN" so it is silently
        skipped when revtype column is not present (already renamed or freshly created).
    -->

    <!-- Ensure user_audit schema exists (defensive: harmless no-op if already present) -->
    <changeSet id="v1-021-ensure-user-audit-schema" author="immortals-ume" runAlways="true">
        <sql>CREATE SCHEMA IF NOT EXISTS user_audit;</sql>
    </changeSet>

    <!-- Ensure revinfo_seq exists -->
    <changeSet id="v1-021-ensure-revinfo-seq" author="immortals-ume" runAlways="true">
        <sql>CREATE SEQUENCE IF NOT EXISTS user_audit.revinfo_seq START WITH 1 INCREMENT BY 1 MINVALUE 1 NO CYCLE;</sql>
    </changeSet>

    <!-- revinfo: create if missing -->
    <changeSet id="v1-021-ensure-revinfo" author="immortals-ume">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="revinfo" schemaName="user_audit"/></not>
        </preConditions>
        <createTable tableName="revinfo" schemaName="user_audit">
            <column name="id"         type="INT" defaultValueComputed="nextval('user_audit.revinfo_seq')">
                <constraints primaryKey="true" primaryKeyName="pk_revinfo" nullable="false"/>
            </column>
            <column name="timestamp"  type="BIGINT"><constraints nullable="false"/></column>
            <column name="username"   type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="user_agent" type="VARCHAR(255)"/>
        </createTable>
        <createIndex indexName="idx_revinfo_timestamp_021" tableName="revinfo" schemaName="user_audit">
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

    <!-- role_AUD: create if missing -->
    <changeSet id="v1-021-ensure-role-aud" author="immortals-ume">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="role_AUD" schemaName="user_audit"/></not>
        </preConditions>
        <createTable tableName="role_AUD" schemaName="user_audit">
            <column name="id"           type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"          type="INT"><constraints nullable="false"/></column>
            <column name="rev_type"     type="SMALLINT"/>
            <column name="version"      type="BIGINT"/>
            <column name="role_id"      type="BIGINT"/>
            <column name="role_name"    type="VARCHAR(20)"/>
            <column name="description"  type="VARCHAR(200)"/>
            <column name="active_ind"   type="BOOLEAN"/>
            <column name="created_by"   type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by"   type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by"   type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>
        <addPrimaryKey constraintName="pk_role_aud_021"
                       tableName="role_AUD" schemaName="user_audit"
                       columnNames="id, rev"/>
        <addForeignKeyConstraint constraintName="fk_role_aud_revinfo_021"
                                 baseTableSchemaName="user_audit" baseTableName="role_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- role_AUD: rename revtype → rev_type if old column name exists -->
    <changeSet id="v1-021-rename-revtype-role-aud" author="immortals-ume">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="role_AUD" schemaName="user_audit" columnName="revtype"/>
        </preConditions>
        <renameColumn tableName="role_AUD" schemaName="user_audit"
                      oldColumnName="revtype" newColumnName="rev_type" columnDataType="SMALLINT"/>
    </changeSet>

