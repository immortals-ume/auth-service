<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="v1-005-cities" author="immortals-ume">
        <createTable tableName="cities" schemaName="user_auth">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('user_auth.cities_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="city_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="state_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="active_ind" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint constraintName="uk_cities_name_state"
                             tableName="cities" schemaName="user_auth"
                             columnNames="city_name, state_id"/>

        <addForeignKeyConstraint constraintName="fk_cities_state"
                                 baseTableSchemaName="user_auth" baseTableName="cities" baseColumnNames="state_id"
                                 referencedTableSchemaName="user_auth" referencedTableName="states"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT" onUpdate="CASCADE"/>

        <createIndex indexName="idx_cities_name" tableName="cities" schemaName="user_auth">
            <column name="city_name"/>
        </createIndex>
        <createIndex indexName="idx_cities_state_id" tableName="cities" schemaName="user_auth">
            <column name="state_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="cities" schemaName="user_auth" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>