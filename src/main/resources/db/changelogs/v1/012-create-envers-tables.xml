<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- revinfo: Envers revision metadata (@RevisionEntity AuditingRevisionEntity) -->
    <changeSet id="v1-012-revinfo" author="immortals-ume">
        <createTable tableName="revinfo" schemaName="user_audit">
            <column name="id"          type="INT"          defaultValueComputed="nextval('user_audit.revinfo_seq')"><constraints primaryKey="true" nullable="false"/></column>
            <column name="timestamp"   type="BIGINT"><constraints nullable="false"/></column>
            <column name="username"    type="VARCHAR(255)"/>
            <column name="ip_address"  type="VARCHAR(255)"/>
            <column name="user_agent"  type="VARCHAR(255)"/>
        </createTable>

        <createIndex indexName="idx_revinfo_timestamp" tableName="revinfo" schemaName="user_audit">
            <column name="timestamp"/>
        </createIndex>

        <rollback>
            <dropTable tableName="revinfo" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- role_AUD -->
    <changeSet id="v1-012-role-aud" author="immortals-ume">
        <createTable tableName="role_AUD" schemaName="user_audit">
            <column name="id"           type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"          type="INT"><constraints nullable="false"/></column>
            <column name="revtype"      type="SMALLINT"/>
            <column name="version"      type="BIGINT"/>
            <column name="role_id"      type="BIGINT"/>
            <column name="role_name"    type="VARCHAR(20)"/>
            <column name="description"  type="VARCHAR(200)"/>
            <column name="active_ind"   type="BOOLEAN"/>
            <column name="created_by"   type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by"   type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by"   type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_role_aud" tableName="role_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_role_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="role_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="role_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- permission_AUD -->
    <changeSet id="v1-012-permission-aud" author="immortals-ume">
        <createTable tableName="permission_AUD" schemaName="user_audit">
            <column name="id"              type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"             type="INT"><constraints nullable="false"/></column>
            <column name="revtype"         type="SMALLINT"/>
            <column name="version"         type="BIGINT"/>
            <column name="permission_name" type="VARCHAR(50)"/>
            <column name="description"     type="VARCHAR(200)"/>
            <column name="active_ind"      type="BOOLEAN"/>
            <column name="created_by"      type="VARCHAR(255)"/>
            <column name="created_date"    type="TIMESTAMP"/>
            <column name="updated_by"      type="VARCHAR(255)"/>
            <column name="updated_date"    type="TIMESTAMP"/>
            <column name="deleted_by"      type="VARCHAR(255)"/>
            <column name="deleted_date"    type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_permission_aud" tableName="permission_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_permission_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="permission_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="permission_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- login_attempt_AUD -->
    <changeSet id="v1-012-login-attempt-aud" author="immortals-ume">
        <createTable tableName="login_attempt_AUD" schemaName="user_audit">
            <column name="id"               type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"              type="INT"><constraints nullable="false"/></column>
            <column name="revtype"          type="SMALLINT"/>
            <column name="version"          type="BIGINT"/>
            <column name="username"         type="VARCHAR(100)"/>
            <column name="ip_address"       type="VARCHAR(45)"/>
            <column name="user_agent"       type="VARCHAR(500)"/>
            <column name="failed_attempts"  type="BIGINT"/>
            <column name="account_blocked"  type="BOOLEAN"/>
            <column name="blocked_at"       type="TIMESTAMP"/>
            <column name="block_expires_at" type="TIMESTAMP"/>
            <column name="last_attempt_at"  type="TIMESTAMP"/>
            <column name="last_success_at"  type="TIMESTAMP"/>
            <column name="active_ind"       type="BOOLEAN"/>
            <column name="created_by"       type="VARCHAR(255)"/>
            <column name="created_date"     type="TIMESTAMP"/>
            <column name="updated_by"       type="VARCHAR(255)"/>
            <column name="updated_date"     type="TIMESTAMP"/>
            <column name="deleted_by"       type="VARCHAR(255)"/>
            <column name="deleted_date"     type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_login_attempt_aud" tableName="login_attempt_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_login_attempt_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="login_attempt_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="login_attempt_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- user_address_AUD (user_id excluded — @NotAudited in entity) -->
    <changeSet id="v1-012-user-address-aud" author="immortals-ume">
        <createTable tableName="user_address_AUD" schemaName="user_audit">
            <column name="id"                type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"               type="INT"><constraints nullable="false"/></column>
            <column name="revtype"           type="SMALLINT"/>
            <column name="version"           type="BIGINT"/>
            <column name="address_uuid"      type="VARCHAR(36)"/>
            <column name="label"             type="VARCHAR(50)"/>
            <column name="address_line1"     type="VARCHAR(255)"/>
            <column name="address_line2"     type="VARCHAR(255)"/>
            <column name="landmark"          type="VARCHAR(255)"/>
            <column name="pincode"           type="VARCHAR(6)"/>
            <column name="address_type"      type="VARCHAR(20)"/>
            <column name="is_default"        type="BOOLEAN"/>
            <column name="status"            type="VARCHAR(20)"/>
            <column name="is_verified"       type="BOOLEAN"/>
            <column name="is_po_box"         type="BOOLEAN"/>
            <column name="timezone"          type="VARCHAR(50)"/>
            <column name="language_code"     type="VARCHAR(5)"/>
            <column name="formatted_address" type="TEXT"/>
            <column name="latitude"          type="NUMERIC(10,7)"/>
            <column name="longitude"         type="NUMERIC(10,7)"/>
            <column name="country_id"        type="BIGINT"/>
            <column name="state_id"          type="BIGINT"/>
            <column name="city_id"           type="BIGINT"/>
            <column name="created_by"        type="VARCHAR(255)"/>
            <column name="created_date"      type="TIMESTAMP"/>
            <column name="updated_by"        type="VARCHAR(255)"/>
            <column name="updated_date"      type="TIMESTAMP"/>
            <column name="deleted_by"        type="VARCHAR(255)"/>
            <column name="deleted_date"      type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_user_address_aud" tableName="user_address_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_user_address_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="user_address_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="user_address_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- countries_AUD -->
    <changeSet id="v1-012-countries-aud" author="immortals-ume">
        <createTable tableName="countries_AUD" schemaName="user_audit">
            <column name="id"           type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"          type="INT"><constraints nullable="false"/></column>
            <column name="revtype"      type="SMALLINT"/>
            <column name="version"      type="BIGINT"/>
            <column name="country_name" type="VARCHAR(100)"/>
            <column name="country_code" type="VARCHAR(5)"/>
            <column name="active_ind"   type="BOOLEAN"/>
            <column name="created_by"   type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by"   type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by"   type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_countries_aud" tableName="countries_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_countries_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="countries_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="countries_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- states_AUD -->
    <changeSet id="v1-012-states-aud" author="immortals-ume">
        <createTable tableName="states_AUD" schemaName="user_audit">
            <column name="id"           type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"          type="INT"><constraints nullable="false"/></column>
            <column name="revtype"      type="SMALLINT"/>
            <column name="version"      type="BIGINT"/>
            <column name="state_name"   type="VARCHAR(100)"/>
            <column name="state_code"   type="VARCHAR(10)"/>
            <column name="country_id"   type="BIGINT"/>
            <column name="active_ind"   type="BOOLEAN"/>
            <column name="created_by"   type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by"   type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by"   type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_states_aud" tableName="states_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_states_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="states_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="states_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <!-- cities_AUD -->
    <changeSet id="v1-012-cities-aud" author="immortals-ume">
        <createTable tableName="cities_AUD" schemaName="user_audit">
            <column name="id"           type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev"          type="INT"><constraints nullable="false"/></column>
            <column name="revtype"      type="SMALLINT"/>
            <column name="version"      type="BIGINT"/>
            <column name="city_name"    type="VARCHAR(100)"/>
            <column name="state_id"     type="BIGINT"/>
            <column name="active_ind"   type="BOOLEAN"/>
            <column name="created_by"   type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by"   type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="deleted_by"   type="VARCHAR(255)"/>
            <column name="deleted_date" type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey constraintName="pk_cities_aud" tableName="cities_AUD" schemaName="user_audit" columnNames="id, rev"/>

        <addForeignKeyConstraint constraintName="fk_cities_aud_revinfo"
                                 baseTableSchemaName="user_audit" baseTableName="cities_AUD" baseColumnNames="rev"
                                 referencedTableSchemaName="user_audit" referencedTableName="revinfo" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="cities_AUD" schemaName="user_audit" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
