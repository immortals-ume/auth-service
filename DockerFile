# ---------- STAGE 1: Dependencies (better caching) ----------
FROM maven:3.9.9-eclipse-temurin-21 AS deps
WORKDIR /build

# copy only pom first (for caching)
COPY pom.xml .
RUN mvn -B -q -e -C dependency:analyze

# ---------- STAGE 2: Build ----------
FROM maven:3.9.9-eclipse-temurin-21 AS builder
WORKDIR /build

COPY --from=deps /root/.m2 /root/.m2
COPY pom.xml .
COPY src ./src

RUN mvn -B -q clean package -DskipTests

# ---------- STAGE 3: Runtime (distroless-like slim image) ----------
FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

# run as non-root (security)
RUN useradd -ms /bin/bash appuser
USER appuser

# copy only jar (thin runtime)
COPY --from=builder /build/target/*.jar app.jar

# JVM tuning (container aware)
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]