# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: dependency cache
# Copying pom + mvnw first so this layer only rebuilds on dependency changes.
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:25-jdk-noble AS deps
WORKDIR /build

COPY mvnw .
COPY .mvn/ .mvn/
COPY pom.xml .
RUN chmod +x mvnw && ./mvnw -B -q dependency:go-offline

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: compile & package (skips tests — run them in CI before building)
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:25-jdk-noble AS builder
WORKDIR /build

COPY --from=deps /root/.m2 /root/.m2
COPY mvnw .
COPY .mvn/ .mvn/
COPY pom.xml .
COPY src ./src
RUN ./mvnw -B -q clean package -DskipTests

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3: minimal runtime image
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:25-jre-noble

WORKDIR /app

# Install curl for HEALTHCHECK; clean up apt cache in the same layer
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (principle of least privilege)
RUN groupadd --system appgroup && useradd --system --gid appgroup appuser
USER appuser

COPY --from=builder /build/target/*.jar app.jar

# Container-aware JVM:
#   UseContainerSupport  — respect cgroup CPU/memory limits
#   MaxRAMPercentage     — use 75% of container RAM for heap
#   urandom entropy      — faster startup in containers (avoids /dev/random blocking)
ENV JAVA_OPTS="-XX:+UseContainerSupport \
               -XX:MaxRAMPercentage=75.0 \
               -Djava.security.egd=file:/dev/./urandom \
               -Dfile.encoding=UTF-8"

EXPOSE 8080
# Management / actuator port (kept internal — expose only to sidecars/service-mesh)
EXPOSE 8081

# Docker-native health check; K8s uses its own probes but this works for local docker-compose
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8081/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
